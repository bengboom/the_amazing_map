{
  "name": "amazing-race-world-map-explorer",
  "version": "1.0.0",
  "private": true,
  "description": "Interactive world map explorer for The Amazing Race US route history.",
  "scripts": {
    "dev": "vite --config vite.config.ts --host 127.0.0.1 --port 5173",
    "build": "tsc -p frontend/tsconfig.json && vite build --config vite.config.ts",
    "preview": "vite preview --config vite.config.ts --host 127.0.0.1 --port 4173",
    "scrape": "python scraper/build_dataset.py",
    "typecheck": "tsc -p frontend/tsconfig.json",
    "deploy": "npm run build && gh-pages -d frontend/dist"
  },
  "dependencies": {
    "@types/leaflet": "^1.9.16",
    "@vitejs/plugin-react": "^4.3.4",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "vite": "^6.0.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "gh-pages": "^6.3.0"
  }
}
